# Stage 1: Build our webui
FROM oven/bun:1 AS webui_build

WORKDIR /app

COPY /webui /app
RUN bun install
RUN bun run build-next

# Stage 2: Build Go server
FROM golang:1.23 AS server_build

WORKDIR /app
COPY . /app
RUN go build -o server cmd/server.go

# Build final image
FROM gcr.io/distroless/base
WORKDIR /app
COPY --from=webui_build /app/dist /app/webui/dist
COPY --from=server_build /app/server /app

CMD ["/app/server"]